  "cards": [
    {
      "dot": "cyan",
      "title": "画面の係",
      "items": [
        "web/src の React が、選ぶ・見る・全部書き出すボタンを出す",
        "ページの順番の正解は持たない。api.ts が依頼を受付へ届ける",
        "pdf.ts の PDF.js が、見ているページだけを絵にする"
      ]
    },
    {
      "dot": "emerald",
      "title": "覚えておく係",
      "items": [
        "app/__main__.py がブラウザを開き、このPCの 127.0.0.1 だけで待つ",
        "session.py がページ一覧と、Windows 一時フォルダの作業用コピーを持つ",
        "auth.py が起動ごとに合言葉を作り、画面以外の依頼を拒む"
      ]
    },
    {
      "dot": "amber",
      "title": "書き出す係",
      "items": [
        "export.py の pikepdf が、残ったページを一時ファイルへコピーする",
        "PDFとして開けることと、ページ数が合うことを確認してから確定する",
        "save_dialog.py が保存先を聞き、open_path.py が保存後にファイルを開く"
      ]
    }
  ]
}
